diff --git a/station/src/franka_fr3_arm_controllers/config/controllers.yaml b/station/src/franka_fr3_arm_controllers/config/controllers.yaml
index 7c11114..1a0b04e 100755
--- a/station/src/franka_fr3_arm_controllers/config/controllers.yaml
+++ b/station/src/franka_fr3_arm_controllers/config/controllers.yaml
@@ -37,13 +37,32 @@
       # presents as "Refusing activation: no valid GELLO joint state".
       #
       # This is deliberately generous, not a safety relaxation: real staleness is enforced
-      # by hasFreshGelloState_() against max_gello_state_age_seconds (0.5 s) using the
+      # by hasFreshGelloState_() against max_gello_liveness_gap (2.0 s, see below) using the
       # LOCAL receive time, which no clock skew can affect. This parameter only sanity
       # checks the message stamp.
       #
       # Tighten this to ~0.5 s once the clock is actually synced -
       # configs/sync_robot_clock.sh does that in one command.
       future_timestamp_tolerance: 10.0  # seconds
+      # Per-message acceptance gate for incoming GELLO samples (validateGelloJointState_).
+      # A message is rejected outright (gello_position_values_ NOT updated) if its own
+      # publisher-stamped header.stamp is older than this relative to local receive time.
+      # Kept tight so a burst of delayed/out-of-order samples after a network hiccup
+      # cannot feed a temporally incoherent target into the arm - widening this value
+      # trades tracking smoothness for shutdown-tolerance; use max_gello_liveness_gap
+      # below for that instead.
+      max_gello_message_age: 0.5   # seconds
+      # Liveness/staleness watchdog (hasFreshGelloState_): how long since the last
+      # ACCEPTED GELLO message, by local receive clock (immune to publisher clock skew),
+      # before the feed is considered dead. Gates on_activate() and
+      # initializeMotionGenerator_(), and triggers RCLCPP_FATAL + rclcpp::shutdown()
+      # (which tears down the whole ros2_control_node, cascading into the robot stack)
+      # in update(). Deliberately wider than max_gello_message_age so transient
+      # ~0.5-2 s DDS/network delivery gaps (observed intermittently on this link; root
+      # cause not fully pinned down) don't trip a fatal shutdown during normal use.
+      # If nuisance shutdowns return, widen THIS value, not max_gello_message_age -
+      # widening the latter reintroduces jittery tracking instead.
+      max_gello_liveness_gap: 2.0   # seconds
       k_alpha: 0.99
       k_gains:
         - 240.0
