<?xml version="1.0" encoding="UTF-8"?>
<!--
  ROBOT side Fast DDS profile: keep ALL DDS traffic on WiFi, so the wired 172.16.16.x link
  carries ONLY the three Franka FCI control streams.

  WHY THIS EXISTS

  base (.10), left arm (.12) and right arm (.11) each run a 1 kHz libfranka control loop,
  and all three share the single USB Ethernet NIC (enx*, r8152) with every byte of DDS
  traffic. On 2026-08-23, with all three in Move mode, the base and the RIGHT arm aborted
  with ["communication_constraints_violation"] within 10 ms of each other, and the LEFT arm
  5 s before that. A simultaneous multi device reflex is one shared link failing, not three
  independent faults.

  ros2_control then demotes each FrankaHardwareInterface to `unconfigured` while its
  controller still reports `active`, so GELLO commands and pedal cmd_vel go nowhere with
  nothing logged. Check with ./base_health.sh (want [claimed]) and
  `ros2 control list_hardware_components` (want state: active).

  DESIGN NOTES

  * interfaceWhiteList pins UDP to the WiFi address ONLY. No DDS touches the wired NIC.
  * SHM is kept: the robot runs many nodes that talk to each other, and
    useBuiltinTransports=false would otherwise drop shared memory and loop that traffic
    back over UDP.
  * initialPeersList is UNICAST. WiFi access points frequently drop or rate limit
    multicast, which would silently break SIMPLE discovery; unicast peers do not depend on
    multicast working at all. Both ends are listed so either may start first.
  * Fast DDS 2.x syntax (interfaceWhiteList), correct for Humble. Fast DDS 3.x renamed it
    to interfaces/allowlist, so do not copy this onto a Kilted machine unchanged.

  Update the addresses if either machine's WiFi IP changes:
    robot  = 192.168.50.150   (wlP1p1s0)
    laptop = 192.168.50.117   (wlan0)
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>wifi_udp</transport_id>
        <type>UDPv4</type>
        <interfaceWhiteList>
          <address>192.168.50.150</address>
        </interfaceWhiteList>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>local_shm</transport_id>
        <type>SHM</type>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="tmr_wifi" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>local_shm</transport_id>
          <transport_id>wifi_udp</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
        <builtin>
          <initialPeersList>
            <locator><udpv4><address>192.168.50.117</address></udpv4></locator>
            <locator><udpv4><address>192.168.50.150</address></udpv4></locator>
          </initialPeersList>
        </builtin>
      </rtps>
    </participant>
  </profiles>
</dds>
