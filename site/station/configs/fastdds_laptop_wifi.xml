<?xml version="1.0" encoding="UTF-8"?>
<!--
  LAPTOP side Fast DDS profile: keep ALL DDS traffic on WiFi, so the robot's wired
  172.16.16.x link carries ONLY the three Franka FCI control streams.

  Pair of ~/fastdds_wifi.xml on the robot. Both ends must use their WiFi profile, or DDS
  keeps announcing on the wired link and the problem remains.

  WHY THIS EXISTS

  The robot's base (.10), left arm (.12) and right arm (.11) each run a 1 kHz libfranka
  control loop over a single USB Ethernet NIC that also carried all DDS. On 2026-08-23,
  with all three in Move mode, the base and RIGHT arm aborted with
  ["communication_constraints_violation"] within 10 ms of each other. ros2_control then
  demotes the hardware to `unconfigured` while the controller still reports `active`, so
  GELLO and pedal commands silently go nowhere.

  DESIGN NOTES

  * interfaceWhiteList pins UDP to wlan0 ONLY. This replaces fastdds_laptop_discovery.xml,
    which pinned DDS to the WIRED NIC and additionally carries a stale address
    (172.16.16.232; this laptop is 172.16.16.140).
  * SHM is kept so the GELLO and pedal nodes on this host talk via shared memory.
  * initialPeersList is UNICAST: WiFi access points often drop or rate limit multicast,
    which would silently break SIMPLE discovery.
  * Fast DDS 2.x syntax, correct for the Humble container that runs the teleop nodes.
    Fast DDS 3.x (the host's Kilted) renamed it to interfaces/allowlist and IGNORES this
    element, which is why it appeared to do nothing when tested on the host.

  Update the addresses if either machine's WiFi IP changes:
    laptop = 192.168.50.117   (wlan0)
    robot  = 192.168.50.150   (wlP1p1s0)
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>wifi_udp</transport_id>
        <type>UDPv4</type>
        <interfaceWhiteList>
          <address>192.168.50.117</address>
        </interfaceWhiteList>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>local_shm</transport_id>
        <type>SHM</type>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="laptop_wifi" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>local_shm</transport_id>
          <transport_id>wifi_udp</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
        <builtin>
          <initialPeersList>
            <locator><udpv4><address>192.168.50.150</address></udpv4></locator>
            <locator><udpv4><address>192.168.50.117</address></udpv4></locator>
          </initialPeersList>
        </builtin>
      </rtps>
    </participant>
  </profiles>
</dds>
